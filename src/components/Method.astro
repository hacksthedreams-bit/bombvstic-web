---
// Los entregables describen el proceso de trabajo, sin plazos ni cifras: no se promete nada que la agencia no haya confirmado.
const steps = [
  {
    n: '01',
    name: 'Descubrir',
    line: 'Entendemos tu negocio antes de proponer nada.',
    items: ['Objetivos y números de partida', 'Clientes, competencia y mercado', 'Qué ya funciona y qué no'],
    icon: 'descubrir',
  },
  {
    n: '02',
    name: 'Definir',
    line: 'Elegimos qué hacer primero, y qué no hacer.',
    items: ['Estrategia y prioridades', 'Alcance claro, por escrito', 'Mensaje y propuesta de valor'],
    icon: 'definir',
  },
  {
    n: '03',
    name: 'Construir',
    line: 'Producimos y ponemos todo en marcha.',
    items: ['Campañas, contenido y videos', 'Webs, dashboards y asistentes de IA', 'Revisión contigo en cada entrega'],
    icon: 'construir',
  },
  {
    n: '04',
    name: 'Evolucionar',
    line: 'Medimos, aprendemos y ajustamos.',
    items: ['Seguimiento de resultados', 'Ajustes sobre datos reales', 'Próximos pasos priorizados'],
    icon: 'evolucionar',
  },
];
---

<section class="section section--cut section--surface method" id="metodo" data-atmo-on="silver" data-section="metodo" aria-labelledby="titulo-metodo">
  <div class="section__inner">
    <p class="section__label"><b>04</b> — Método</p>
    <h2 class="method__title" id="titulo-metodo">Cuatro movimientos. <span class="accent">Cero</span> improvisación.</h2>
    <p class="method__lead" data-reveal>Así trabajamos, de la primera conversación a los resultados.</p>

    <ol class="method__list" data-method>
      <li class="method__rail" aria-hidden="true"><span class="method__fill" data-method-fill></span></li>
      {steps.map((s) => (
        <li class="step" data-step>
          <span class="step__dot" aria-hidden="true"></span>
          <svg class="step__icon" viewBox="0 0 96 68" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {s.icon === 'descubrir' && (
              <>
                <path d="M18 34H78M48 4V64" stroke="#75707F" stroke-width="1.5" />
                <circle cx="48" cy="34" r="21" stroke="#d8d9e3" stroke-width="2" />
                <circle cx="48" cy="34" r="4" fill="#ad8bfa" />
              </>
            )}
            {s.icon === 'definir' && (
              <>
                <path d="M20 12L76 12L62 56L34 56Z" stroke="#d8d9e3" stroke-width="2" />
                <path d="M34 34H62" stroke="#ad8bfa" stroke-width="2" />
              </>
            )}
            {s.icon === 'construir' && (
              <>
                <rect x="20" y="12" width="36" height="36" rx="2" stroke="#d8d9e3" stroke-width="2" />
                <rect x="40" y="30" width="36" height="28" rx="2" fill="#20182e" stroke="#ad8bfa" stroke-width="2" />
              </>
            )}
            {s.icon === 'evolucionar' && (
              <>
                <path d="M18 54L36 36L52 44L78 16" stroke="#d8d9e3" stroke-width="2" />
                <path d="M59 16H78V35" stroke="#ad8bfa" stroke-width="2" />
              </>
            )}
          </svg>
          <div class="step__head">
            <p class="step__num">{s.n}</p>
            <h3 class="step__name">{s.name}</h3>
          </div>
          <div class="step__body">
            <p class="step__line">{s.line}</p>
            <ul class="step__items">
              {s.items.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
