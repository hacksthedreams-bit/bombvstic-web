---
// OJO — antes de publicar: permiso de cada cliente para mostrar su nombre y su pieza.
// Solo se publica lo que consta en el material entregado por la agencia (textos de las historias); sin cifras inventadas.
import { u } from '../lib/url';
const arrow = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>`;

const upcoming = [
  { name: 'ElMostaShop', kind: 'E-commerce de productos digitales', did: 'Marca completa y redes' },
];

// Caso La Terraza de Lupita (ficha 609): seis historias en video entregadas por la agencia (carpeta BOMBVSTIC_Lupita_Historias_01_a_06).
// OJO — antes de publicar en el dominio definitivo: confirmar el permiso formal de La Terraza de Lupita para mostrar su nombre, su marca y la conversación de la historia 05.
// Los textos de `did` y `alt` salen de las propias historias; sin cifras.
const lupita = [
  { n: '01', title: 'Apertura', alt: 'Historia de Instagram en video: «Dos marcas. Una cocina con historia.» Los logos de La Terraza de Lupita y platos de comida chileno-mexicana sobre vitrinas doradas.' },
  { n: '02', title: 'Identidad', alt: 'Historia de Instagram en video: «Un restaurante. Dos historias. Una identidad.» El antes y el después del logo y de las piezas de La Terraza de Lupita.' },
  { n: '03', title: 'Carta y catálogo', alt: 'Historia de Instagram en video: «El sabor entra por los ojos. La marca también.» La carta física y el catálogo de WhatsApp con la misma identidad.' },
  { n: '04', title: 'Desarrollo web', alt: 'Historia de Instagram en video: «Dos cocinas. Una misma mesa.» La página web con la carta en imágenes y el pedido por WhatsApp.' },
  { n: '05', title: 'Atención por WhatsApp', alt: 'Historia de Instagram en video: «Todo empieza con un hola.» Extracto de una conversación en la que el asistente de IA atiende al cliente y toma el pedido, y el equipo toma el relevo.' },
  { n: '06', title: 'Contenido y redes', alt: 'Historia de Instagram en video: «El antojo empieza antes de llegar.» Reels y gestión de redes con la preparación de los platos.' },
];
const lupitaDid = [
  'Refinamiento de identidad: dos marcas bajo una misma, La Terraza de Lupita by Mister Mechada',
  'Carta física y catálogo de WhatsApp con la misma identidad',
  'Página web con la carta en imágenes y pedidos por WhatsApp',
  'Asistente de IA en WhatsApp que atiende y toma pedidos, con el equipo al relevo',
  'Contenido y gestión de redes: reels con la preparación de los platos',
];

// Caso Digital Sneakers Shop: cinco historias de Instagram (la 03 es video)
const stories = [
  { n: '01', title: 'Transformación', alt: 'Historia de Instagram: «Un nuevo nombre. Una nueva manera de competir.», con el logo renovado de Digital Sneakers Shop sobre un marco dorado.' },
  { n: '02', title: 'Identidad', alt: 'Historia de Instagram sobre la identidad: el logo con zapatilla y canasta, versiones horizontales y un sello circular de Digital Sneakers Shop.' },
  { n: '03', title: 'Catálogo y motion', alt: 'Historia de Instagram con video: el nombre Digital Sneakers Shop animado dentro de un marco horizontal.', video: true },
  { n: '04', title: 'Experiencia', alt: 'Historia de Instagram sobre la experiencia de compra: mensaje de agradecimiento con el logo y tres íconos de pago, información y seguimiento.' },
  { n: '05', title: 'Hito', alt: 'Historia de Instagram: «La competencia pasó a ser la nueva dueña», con el logotipo de Digital Sneakers Shop sobre un bloque de piedra.' },
];
const did = [
  'Renovación de marca: de Savage Sneaker 999 a Digital Sneakers Shop',
  'Identidad visual: logo, símbolo, colores y versiones digitales',
  'Catálogo visual y piezas animadas',
  'Comunicación de compra y poscompra',
];
---

<section class="section section--cut projects" id="proyectos" data-atmo-on="indigo" data-section="proyectos" aria-labelledby="titulo-proyectos">
  <div class="section__inner">
    <p class="section__label"><b>03</b>{' '}<span class="section__name">Proyectos</span></p>
    <h2 class="projects__title" id="titulo-proyectos">Trabajo real para negocios <span class="accent">reales.</span></h2>
    <p class="projects__lead" data-reveal>
      Vamos sumando cada caso con su permiso y con cifras verificadas, no con adjetivos.
    </p>

    <!-- Caso 01 · Digital Sneakers Shop -->
    <article class="case" aria-labelledby="caso-dss">
      <header class="case__head">
        <p class="feature__tag" data-reveal>Proyecto · E-commerce</p>
        <h3 class="case__name" id="caso-dss" data-reveal>Digital Sneakers Shop</h3>
        <p class="case__lead" data-reveal>Un nuevo nombre. Una nueva manera de competir.</p>
        <ul class="case__did" data-reveal>
          {did.map((d) => <li>{d}</li>)}
        </ul>
        <p class="case__milestone" data-reveal>
          <b>Hito</b>
          Tras el crecimiento de Digital Sneakers Shop, su propietario vendió la marca a un competidor del sector.
        </p>
      </header>

      <div class="stories-stage" data-stories-stage>
      <p class="stories-stage__ghost" aria-hidden="true" data-ghost>Digital Sneakers Shop</p>
      <p class="stories-stage__hud" aria-hidden="true">
        <span class="hud__count"><b data-hud-count>01</b> / 05</span>
        <span class="hud__bar"><i data-hud-bar></i></span>
      </p>
      <ol class="stories" data-stories tabindex="0" aria-label="Las cinco historias del caso, desliza para verlas">
        {stories.map((s) => (
          <li class="story">
            <figure>
              <div class="story__frame">
                {s.video ? (
                  <>
                    <!-- Póster como imagen perezosa detrás del video (ficha 602): el atributo `poster` se descargaba al cargar la página aunque el video está muy abajo -->
                    <img
                      class="story__poster"
                      src={u('/media/proyectos/dss-03-720.webp')}
                      srcset={`${u('/media/proyectos/dss-03-480.webp')} 480w, ${u('/media/proyectos/dss-03-720.webp')} 720w`}
                      sizes="(min-width: 900px) 18vw, 70vw"
                      width="720"
                      height="1280"
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      decoding="async"
                    />
                    <video
                      class="story__video"
                      data-story-video
                      muted
                      loop
                      playsinline
                      preload="none"
                      width="720"
                      height="1280"
                      aria-label={s.alt}
                    >
                      <source src={u('/media/proyectos/dss-03-motion.mp4')} type="video/mp4" />
                    </video>
                    <button class="story__toggle" type="button" data-story-toggle aria-label="Reproducir video" aria-pressed="false">
                      <span class="story__icon" aria-hidden="true"></span>
                    </button>
                  </>
                ) : (
                  <img
                    src={u(`/media/proyectos/dss-${s.n}-720.webp`)}
                    srcset={`${u(`/media/proyectos/dss-${s.n}-480.webp`)} 480w, ${u(`/media/proyectos/dss-${s.n}-720.webp`)} 720w`}
                    sizes="(min-width: 900px) 18vw, 70vw"
                    width="720"
                    height="1280"
                    alt={s.alt}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
              <figcaption><span>{s.n}</span> {s.title}</figcaption>
            </figure>
          </li>
        ))}
      </ol>
      </div>

      <a class="feature__link" href="#contacto" data-topic="Un proyecto como Digital Sneakers Shop" data-cta="caso" data-reveal>
        Quiero algo así
        <span class="btn__arrow" aria-hidden="true" set:html={arrow} />
      </a>
    </article>

    <!-- Caso 02 · La Terraza de Lupita (restaurante): seis historias en video en un carrusel con botones -->
    <article class="case case--reel" aria-labelledby="caso-lupita">
      <header class="case__head">
        <p class="feature__tag" data-reveal>Proyecto · Restaurante</p>
        <h3 class="case__name" id="caso-lupita" data-reveal>La Terraza de Lupita</h3>
        <p class="case__lead" data-reveal>Dos marcas. Una cocina con historia.</p>
        <ul class="case__did" data-reveal>
          {lupitaDid.map((d) => <li>{d}</li>)}
        </ul>
      </header>

      <div class="reel" data-reel>
        <ol class="stories stories--reel" role="list" data-reel-track tabindex="0" aria-label="Las seis historias del caso en video, desliza o usa los botones para verlas">
          {lupita.map((s) => (
            <li class="story">
              <figure>
                <div class="story__frame">
                  <img
                    class="story__poster"
                    src={u(`/media/proyectos/lupita-${s.n}-720.webp`)}
                    srcset={`${u(`/media/proyectos/lupita-${s.n}-480.webp`)} 480w, ${u(`/media/proyectos/lupita-${s.n}-720.webp`)} 720w`}
                    sizes="(min-width: 900px) 17rem, 72vw"
                    width="720"
                    height="1280"
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    decoding="async"
                  />
                  <video class="story__video" data-reel-video muted loop playsinline preload="none" width="720" height="1280" aria-label={s.alt}>
                    <source src={u(`/media/proyectos/lupita-${s.n}.mp4`)} type="video/mp4" />
                  </video>
                  <button class="story__toggle" type="button" data-reel-toggle aria-label={`Reproducir la historia ${s.n}`} aria-pressed="false">
                    <span class="story__icon" aria-hidden="true"></span>
                  </button>
                </div>
                <figcaption><span>{s.n}</span> {s.title}</figcaption>
              </figure>
            </li>
          ))}
        </ol>
        <div class="reel__nav">
          <button class="reel__btn" type="button" data-reel-prev aria-label="Historia anterior" aria-disabled="true">
            <span class="btn__arrow" aria-hidden="true" set:html={arrow} />
          </button>
          <p class="reel__count" aria-hidden="true"><b data-reel-count>01</b> / 06</p>
          <p class="sr-only" role="status" aria-live="polite" data-reel-status>Historia 1 de 6</p>
          <button class="reel__btn reel__btn--next" type="button" data-reel-next aria-label="Historia siguiente">
            <span class="btn__arrow" aria-hidden="true" set:html={arrow} />
          </button>
        </div>
      </div>

      <a class="feature__link" href="#contacto" data-topic="Un proyecto como La Terraza de Lupita" data-cta="caso" data-reveal>
        Quiero algo así
        <span class="btn__arrow" aria-hidden="true" set:html={arrow} />
      </a>
    </article>

    <!-- Caso 03 · Calyzzo -->
    <article class="feature feature--second">
      <div class="feature__media" data-cut-reveal>
        <picture>
          <img
            src={u('/media/proyectos/calyzzo-940.webp')}
            srcset={`${u('/media/proyectos/calyzzo-640.webp')} 640w, ${u('/media/proyectos/calyzzo-940.webp')} 940w`}
            sizes="(min-width: 900px) 56vw, 92vw"
            width="940"
            height="700"
            alt="Fotografía de la piscina de Calyzzo al atardecer junto a su identidad de marca: una placa negra con el logo dorado de Calyzzo Events & Pool"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
      <div class="feature__body">
        <p class="feature__tag" data-reveal>Proyecto · Centro de eventos</p>
        <h3 class="feature__name" data-reveal>Calyzzo</h3>
        <ul class="feature__did" data-reveal>
          <li>Identidad de marca completa</li>
          <li>Gestión de redes y crecimiento</li>
        </ul>
        <a class="feature__link" href="#contacto" data-topic="Un proyecto como Calyzzo" data-cta="caso" data-reveal>
          Quiero algo así
          <span class="btn__arrow" aria-hidden="true" set:html={arrow} />
        </a>
      </div>
    </article>

    <div class="upcoming">
      <h3 class="upcoming__label">Próximos casos</h3>
      <ul class="upcoming__list">
        {upcoming.map((c, i) => (
          <li class="upcoming__row" data-row>
            <span class="upcoming__idx">{String(i + 4).padStart(2, '0')}</span>
            <span class="upcoming__name">{c.name}</span>
            <span class="upcoming__meta">{c.kind} · {c.did}</span>
            <span class="upcoming__chip">En preparación</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // Póster perezoso (ficha 602): la imagen vive en una pista horizontal y `loading="lazy"` no la adelanta cuando solo asoma por un costado; al
  // acercarse la pista al pliegue (1 200 px) se pasa a `eager` para que ya esté lista cuando se deslice a esa historia (sin cuadro vacío).
  const poster = document.querySelector<HTMLImageElement>('.story__poster');
  const track = document.querySelector<HTMLElement>('[data-stories]');
  if (poster && track && 'IntersectionObserver' in window) {
    const near = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        poster.loading = 'eager';
        near.disconnect();
      },
      { rootMargin: '1200px 0px' },
    );
    near.observe(track);
  }

  // Video del caso: reproduce en silencio solo mientras se ve (y si la persona no pidió menos movimiento); siempre con botón de pausa.
  const video = document.querySelector<HTMLVideoElement>('[data-story-video]');
  const btn = document.querySelector<HTMLButtonElement>('[data-story-toggle]');
  if (video && btn) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let userPaused = reduce.matches;
    const sync = () => {
      const playing = !video.paused;
      btn.setAttribute('aria-pressed', String(playing));
      btn.setAttribute('aria-label', playing ? 'Pausar video' : 'Reproducir video');
      btn.classList.toggle('is-playing', playing);
    };
    const play = () => video.play().then(sync).catch(sync);
    btn.addEventListener('click', () => {
      if (video.paused) {
        userPaused = false;
        play();
      } else {
        userPaused = true;
        video.pause();
        sync();
      }
    });
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting && !userPaused) {
            video.preload = 'auto';
            play();
          } else if (!e.isIntersecting) {
            video.pause();
          }
        },
        { threshold: 0.55 },
      ).observe(video);
    }
    sync();
  }
</script>

<script>
  // Caso La Terraza de Lupita (ficha 609): carrusel de seis historias en video.
  // - Los pósters son imágenes perezosas dentro de una pista horizontal: al acercarse la pista se pasan a `eager` (igual que en el caso anterior, ficha 602).
  // - Solo se reproduce UNA historia a la vez, la que está al centro, en silencio y solo si la persona no pidió menos movimiento ni ahorro de datos.
  // - Botones anterior/siguiente (clic y teclado) y contador; la pista también se desliza con el dedo, el trackpad o las flechas.
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  const track = reel?.querySelector<HTMLElement>('[data-reel-track]');
  if (reel && track) {
    const posters = [...track.querySelectorAll<HTMLImageElement>('.story__poster')];
    const items = [...track.querySelectorAll<HTMLElement>('.story')];
    const prev = reel.querySelector<HTMLButtonElement>('[data-reel-prev]');
    const next = reel.querySelector<HTMLButtonElement>('[data-reel-next]');
    const count = reel.querySelector<HTMLElement>('[data-reel-count]');
    const status = reel.querySelector<HTMLElement>('[data-reel-status]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const saveData = !!conn?.saveData;

    if ('IntersectionObserver' in window) {
      const near = new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return;
          posters.forEach((p) => (p.loading = 'eager'));
          near.disconnect();
        },
        { rootMargin: '1200px 0px' },
      );
      near.observe(track);
    }

    // ── reproducción ──
    // Una sola historia suena: la más cercana al centro de la pista, mientras la pista se vea. Sin reproducción automática con «reducir movimiento»,
    // ahorro de datos o conexión 2G/3G (el botón de cada historia la inicia igual).
    const slow = !!conn?.effectiveType && /(^|slow-)(2g|3g)$/.test(conn.effectiveType);
    type Cell = { video: HTMLVideoElement; btn: HTMLButtonElement; paused: boolean };
    const cells: Cell[] = items.map((li) => ({
      video: li.querySelector<HTMLVideoElement>('[data-reel-video]')!,
      btn: li.querySelector<HTMLButtonElement>('[data-reel-toggle]')!,
      paused: reduce.matches || saveData || slow,
    }));
    const sync = (c: Cell) => {
      const playing = !c.video.paused;
      c.btn.setAttribute('aria-pressed', String(playing)); // una sola señal: el botón conserva su nombre y cambia su estado
      c.btn.classList.toggle('is-playing', playing);
    };
    const play = (c: Cell) => {
      c.video.preload = 'auto';
      c.video.play().then(() => sync(c)).catch(() => sync(c));
    };
    const only = (keep: number) =>
      cells.forEach((c, j) => {
        if (j !== keep && !c.video.paused) {
          c.video.pause();
          sync(c);
        }
      });
    cells.forEach((c, i) => {
      c.btn.addEventListener('click', () => {
        if (c.video.paused) {
          c.paused = false;
          only(i);
          play(c);
        } else {
          c.paused = true;
          c.video.pause();
          sync(c);
        }
      });
      c.video.addEventListener('play', () => sync(c));
      c.video.addEventListener('pause', () => sync(c));
      // los videos arrancan con el escenario vacío: hasta que pasan los primeros 0,3 s se ve el póster, que ya muestra la historia completa
      c.video.addEventListener('timeupdate', () => c.video.classList.toggle('is-started', c.video.currentTime > 0.3));
    });
    let trackVisible = false;
    const centered = () => {
      const r = track.getBoundingClientRect();
      const mid = r.left + r.width / 2;
      let best = 0;
      let dist = Infinity;
      items.forEach((li, i) => {
        const b = li.getBoundingClientRect();
        const d = Math.abs(b.left + b.width / 2 - mid);
        if (d < dist) {
          dist = d;
          best = i;
        }
      });
      return best;
    };
    let settle = 0;
    const settleSoon = () => {
      window.clearTimeout(settle);
      settle = window.setTimeout(() => {
        const i = centered();
        if (status) status.textContent = `Historia ${i + 1} de ${items.length}`;
        if (!trackVisible) return;
        only(i);
        if (!cells[i].paused && cells[i].video.paused) play(cells[i]);
      }, 160);
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => {
          trackVisible = e.isIntersecting;
          if (!trackVisible) cells.forEach((c) => !c.video.paused && c.video.pause());
          else settleSoon();
        },
        { threshold: 0.35 },
      ).observe(track);
    }

    // ── botones y contador ──
    const step = () => (items[1] ? items[1].offsetLeft - items[0].offsetLeft : track.clientWidth);
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const idx = Math.min(items.length, Math.max(1, Math.round(track.scrollLeft / step()) + 1));
      const atEnd = track.scrollLeft >= max - 2;
      if (count) count.textContent = String(atEnd ? items.length : idx).padStart(2, '0');
      // `aria-disabled` y no `disabled`: si el botón se apaga con el foco encima, el foco no se pierde
      prev?.setAttribute('aria-disabled', String(track.scrollLeft <= 2));
      next?.setAttribute('aria-disabled', String(atEnd));
    };
    const go = (dir: number) => track.scrollBy({ left: dir * step(), behavior: reduce.matches ? 'auto' : 'smooth' });
    prev?.addEventListener('click', () => prev.getAttribute('aria-disabled') !== 'true' && go(-1));
    next?.addEventListener('click', () => next.getAttribute('aria-disabled') !== 'true' && go(1));
    track.addEventListener(
      'scroll',
      () => {
        update();
        settleSoon();
      },
      { passive: true },
    );
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>
