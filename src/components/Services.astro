---
import { u } from '../lib/url';
// Todo interés lleva al diagnóstico (#contacto) con la opción correspondiente ya marcada: data-need + data-topic (ficha 301)
const arrow = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>`;

// GIF transparente de 1×1: marcador hasta que la tarjeta se acerca (ficha 603)
const PIXEL = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';

const cards = [
  {
    n: '01',
    title: 'Publicidad',
    accent: 'y campañas',
    lead: 'Campañas en Meta Ads pensadas para vender: creatividades que se notan y resultados que se miden.',
    items: ['Estrategia y gestión de campañas', 'Videos para Meta Ads', 'Medición y ajustes constantes'],
    img: 'publicidad',
    pos: '15% 50%',
    r: '-2.2deg',
    alt: 'Imán de titanio con un extremo violeta atrayendo tres esferas negras',
    need: 0,
    topic: 'Publicidad y campañas',
  },
  {
    n: '02',
    title: 'Marca',
    accent: 'y contenido',
    lead: 'Identidad con criterio y contenido constante: que te reconozcan a la primera y te elijan a la segunda.',
    items: ['Identidad de marca completa', 'Contenido para redes: reels, historias y piezas', 'Gestión y crecimiento de redes'],
    img: 'marca-casos',
    ws: [640, 960],
    pos: '50% 50%',
    tag: 'Casos reales',
    r: '1.4deg',
    alt: 'Tres historias de Instagram de casos reales: la identidad de Digital Sneakers Shop y la identidad y el contenido de La Terraza de Lupita',
    need: 1,
    topic: 'Marca y contenido',
  },
  {
    n: '03',
    title: 'IA',
    accent: 'y software',
    lead: 'Páginas web, asistentes de IA, dashboards y sistemas hechos a la medida de cómo trabaja tu negocio.',
    items: ['Páginas web', 'Asistentes de IA para atender', 'Dashboards, apps y sistemas'],
    img: 'ia-lupita',
    ws: [640, 960],
    pos: '50% 50%',
    tag: 'Caso real · La Terraza de Lupita',
    r: '-1.2deg',
    alt: 'Extracto de una conversación real de WhatsApp: el cliente pide papas fritas individuales y el asistente de IA de La Terraza de Lupita responde con el precio y pregunta por la cantidad',
    need: 2,
    topic: 'IA y software',
  },
];

const all = [
  {
    group: 'Growth y Marca',
    items: [
      { t: 'Estrategia de marketing digital', d: 'Un plan claro: a quién le hablas, por dónde y con qué mensaje.', need: 0 },
      { t: 'Branding e identidad', d: 'Nombre, logo, colores y voz para que te reconozcan.', need: 1 },
      { t: 'Creación de contenido', d: 'Reels, historias y piezas que muestran lo que haces.', need: 1 },
      { t: 'Gestión de redes sociales', d: 'Publicamos, respondemos y cuidamos tu comunidad.', need: 1 },
      { t: 'Campañas publicitarias', d: 'Anuncios en Meta pensados para generar consultas y ventas.', need: 0 },
      { t: 'Videos para Meta Ads', d: 'Piezas en video pensadas para anunciar.', need: 0 },
      { t: 'Asesoría para vender cursos y comunidades', d: 'Cómo ordenar tu oferta y vender conocimiento en línea.', need: 4 },
    ],
  },
  {
    group: 'IA y Software',
    items: [
      { t: 'Páginas web', d: 'Claras, ordenadas y pensadas para que te contacten.', need: 2 },
      { t: 'Dashboards a medida', d: 'Tus números en una sola pantalla, sin planillas.', need: 2 },
      { t: 'Asistentes de IA', d: 'Atienden por WhatsApp y ayudan a tomar pedidos mientras tu equipo trabaja.', need: 3 },
      { t: 'Apps a la medida', d: 'Herramientas hechas como trabaja tu negocio.', need: 2 },
      { t: 'Sistemas para empresas', d: 'Procesos manuales que pasan a un sistema hecho a tu medida.', need: 3 },
    ],
  },
];
---

<section class="section services" id="servicios" data-atmo-on="indigo" data-section="servicios" aria-labelledby="titulo-servicios">
  <div class="section__inner">
    <p class="section__label"><b>02</b>{' '}<span class="section__name">Servicios</span></p>
    <h2 class="services__title" id="titulo-servicios">Tres frentes. Un objetivo: que te <span class="accent">elijan.</span></h2>
    <p class="services__lead" data-reveal>
      Atraemos a las personas correctas con publicidad que se mide, las convencemos con una marca que se recuerda y ordenamos tu operación con tecnología a tu medida.
    </p>

    <div class="svc-grid">
      {cards.map((c, i) => (
        <article class="svc" data-svc style={`--i:${i}`}>
          <div class="svc__card" style={`--r:${c.r}`}>
            <div class="svc__window">
              <div class="svc__media">
                <!-- Ficha 603: la imagen real se asigna al acercarse la tarjeta (script de abajo). `loading="lazy"` no sirve aquí: con conexión lenta Chrome sube su umbral a 2 500 px y las baja al cargar, compitiendo con el LCP. El marcador conserva alt, ancho y alto. -->
                <picture data-svc-pic>
                  <img
                    src={PIXEL}
                    data-lazy-src={u(`/media/servicios/${c.img}-${(c.ws ?? [640, 960])[1]}.webp`)}
                    data-lazy-srcset={(c.ws ?? [640, 960]).map((w) => `${u(`/media/servicios/${c.img}-${w}.webp`)} ${w}w`).join(', ')}
                    sizes="(min-width: 900px) 30vw, 92vw"
                    width="960"
                    height={c.ws ? '960' : '720'}
                    alt={c.alt}
                    decoding="async"
                    style={`object-position:${c.pos};transform-origin:${c.origin ?? '50% 50%'}`}
                  />
                </picture>
                <noscript>
                  <img
                    src={u(`/media/servicios/${c.img}-${(c.ws ?? [640, 960])[1]}.webp`)}
                    srcset={(c.ws ?? [640, 960]).map((w) => `${u(`/media/servicios/${c.img}-${w}.webp`)} ${w}w`).join(', ')}
                    sizes="(min-width: 900px) 30vw, 92vw"
                    width="960"
                    height={c.ws ? '960' : '720'}
                    alt={c.alt}
                    loading="lazy"
                    decoding="async"
                    style={`object-position:${c.pos}`}
                  />
                </noscript>
                <span class="svc__sweep" aria-hidden="true"></span>
              </div>
              <span class="svc__edge" aria-hidden="true"></span>
              {c.tag && <span class="svc__tag">{c.tag}</span>}
            </div>
            <div class="svc__body">
              <p class="svc__num">{c.n}</p>
              <h3 class="svc__name">{c.title} <span class="accent">{c.accent}</span></h3>
              <p class="svc__lead">{c.lead}</p>
              <ul class="svc__list">
                {c.items.map((i) => <li>{i}</li>)}
              </ul>
              <a class="svc__link" href="#contacto" data-need={c.need} data-topic={c.topic} data-cta="servicio-tarjeta">
                Conversemos
                <span class="btn__arrow" aria-hidden="true" set:html={arrow} />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="tiles" aria-labelledby="titulo-muro">
      <h3 class="section__label" id="titulo-muro">Todo lo que hacemos</h3>
      {all.map((g, gi) => (
        <div class="tiles__group">
          <p class="tiles__group-name">{String.fromCharCode(65 + gi)} — {g.group}</p>
          <ul class="tiles__list">
            {g.items.map((item, i) => (
              <li class="tile" data-row>
                <a href="#contacto" data-need={item.need} data-topic={item.t} data-cta="servicio-muro">
                  <span class="tile__idx">{String.fromCharCode(65 + gi)}.{String(i + 1).padStart(2, '0')}</span>
                  <span class="tile__name">{item.t}</span>
                  <span class="tile__desc">{item.d}</span>
                  <span class="tile__go" aria-hidden="true"><span set:html={arrow} /> Lo quiero</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </div>
</section>

<script is:inline>
  // Ficha 603: asigna la imagen real de cada tarjeta cuando está a 1 000 px de entrar en pantalla, al pulsar un ancla (#…) o si la página abre con ancla.
  // Sin IntersectionObserver, de una vez. `__svcLazy` avisa a motion.ts que este script corrió (si no, motion.ts hace de respaldo).
  (function () {
    try {
      window.__svcLazy = true;
      var done = function (i) { i.classList.remove('is-lazy-loading'); };
      var go = function (i) {
        var src = i.getAttribute('data-lazy-src');
        if (!src) return;
        var set = i.getAttribute('data-lazy-srcset');
        i.removeAttribute('data-lazy-src');
        i.removeAttribute('data-lazy-srcset');
        i.classList.add('is-lazy-loading');
        i.addEventListener('load', function () { done(i); }, { once: true });
        i.addEventListener('error', function () { done(i); }, { once: true });
        if (set) i.srcset = set;
        i.src = src;
      };
      var all = function () { [].forEach.call(document.querySelectorAll('img[data-lazy-src]'), go); };
      if (!('IntersectionObserver' in window)) { all(); return; }
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          [].forEach.call(e.target.querySelectorAll('img[data-lazy-src]'), go);
        });
      }, { rootMargin: '1000px 0px' });
      [].forEach.call(document.querySelectorAll('[data-svc]'), function (c) { io.observe(c); });
      if (location.hash.length > 1) all();
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[href^="#"]');
        if (a && a.getAttribute('href').length > 1) all();
      }, true);
    } catch (err) { document.querySelectorAll && [].forEach.call(document.querySelectorAll('img[data-lazy-src]'), function (i) { i.src = i.getAttribute('data-lazy-src'); var t = i.getAttribute('data-lazy-srcset'); if (t) i.srcset = t; }); }
  })();
</script>
