---
import { u } from '../lib/url';
// Todo interés lleva al diagnóstico (#contacto) con la opción correspondiente ya marcada: data-need + data-topic (ficha 301)
const arrow = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>`;

// GIF transparente de 1×1: marcador hasta que la tarjeta se acerca (ficha 603)
const PIXEL = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';

const cards = [
  {
    n: '01',
    title: 'Publicidad',
    accent: 'y campañas',
    lead: 'Campañas y videos hechos para Meta Ads, pensados para vender y no solo para gustar.',
    items: ['Gestión de campañas publicitarias', 'Videos publicitarios para Meta Ads', 'Medición y ajustes constantes'],
    img: 'publicidad',
    pos: '15% 50%',
    r: '-2.2deg',
    alt: 'Imán de titanio con un extremo violeta atrayendo tres esferas negras',
    need: 0,
    topic: 'Publicidad y campañas',
  },
  {
    n: '02',
    title: 'Marca',
    accent: 'y contenido',
    lead: 'Una identidad clara y contenido constante para que te reconozcan y te elijan.',
    items: ['Branding e identidad completa', 'Creación de contenido', 'Gestión de redes sociales'],
    img: 'marca-dss',
    ws: [640, 720],
    pos: '50% 50%',
    tag: 'Caso real · Digital Sneakers Shop',
    r: '1.4deg',
    alt: 'Historia de Instagram del caso Digital Sneakers Shop: el logo renovado con dos versiones horizontales y un sello circular',
    need: 1,
    topic: 'Marca y contenido',
  },
  {
    n: '03',
    title: 'IA',
    accent: 'y software',
    lead: 'Páginas web, dashboards, asistentes de IA y sistemas hechos a la medida de cómo trabaja tu negocio.',
    items: ['Páginas web', 'Dashboards y apps a medida', 'Asistentes de IA y sistemas para empresas'],
    img: 'ia-demo',
    ws: [640, 960],
    pos: '50% 0%',
    tag: 'Ejemplo ilustrativo',
    r: '-1.2deg',
    alt: 'Captura de la demostración de esta página: el interruptor en «Personas + IA» y los primeros pasos de un restaurante, cada uno con la etiqueta «Asistente»',
    need: 2,
    topic: 'IA y software',
  },
];

const wall = [
  {
    group: 'Growth y Marca',
    items: [
      { t: 'Estrategia de marketing digital', need: 0 },
      { t: 'Branding e identidad', need: 1 },
      { t: 'Creación de contenido', need: 1 },
      { t: 'Gestión de redes sociales', need: 1 },
      { t: 'Campañas publicitarias', need: 0 },
      { t: 'Videos para Meta Ads', need: 0 },
      { t: 'Asesoría para vender cursos y comunidades', need: 4 },
    ],
  },
  {
    group: 'IA y Software',
    items: [
      { t: 'Páginas web', need: 2 },
      { t: 'Dashboards a medida', need: 2 },
      { t: 'Asistentes de IA', need: 3 },
      { t: 'Apps a la medida', need: 2 },
      { t: 'Sistemas para empresas', need: 3 },
    ],
  },
];
---

<section class="section services" id="servicios" data-atmo-on="indigo" data-section="servicios" aria-labelledby="titulo-servicios">
  <div class="section__inner">
    <p class="section__label"><b>02</b> — Servicios</p>
    <h2 class="services__title" id="titulo-servicios">Tres frentes. Un mismo <span class="accent">resultado.</span></h2>
    <p class="services__lead" data-reveal>
      Publicidad que trae clientes, una marca que se recuerda y tecnología que ordena la operación. Todo bajo el mismo equipo.
    </p>

    <div class="svc-grid">
      {cards.map((c, i) => (
        <article class="svc" data-svc style={`--i:${i}`}>
          <div class="svc__card" style={`--r:${c.r}`}>
            <div class="svc__window">
              <div class="svc__media">
                <!-- Ficha 603: la imagen real se asigna al acercarse la tarjeta (script de abajo). `loading="lazy"` no sirve aquí: con conexión lenta Chrome sube su umbral a 2 500 px y las baja al cargar, compitiendo con el LCP. El marcador conserva alt, ancho y alto. -->
                <picture data-svc-pic>
                  <img
                    src={PIXEL}
                    data-lazy-src={u(`/media/servicios/${c.img}-${(c.ws ?? [640, 960])[1]}.webp`)}
                    data-lazy-srcset={(c.ws ?? [640, 960]).map((w) => `${u(`/media/servicios/${c.img}-${w}.webp`)} ${w}w`).join(', ')}
                    sizes="(min-width: 900px) 30vw, 92vw"
                    width="960"
                    height={c.ws ? '960' : '720'}
                    alt={c.alt}
                    decoding="async"
                    style={`object-position:${c.pos};transform-origin:${c.origin ?? '50% 50%'}`}
                  />
                </picture>
                <noscript>
                  <img
                    src={u(`/media/servicios/${c.img}-${(c.ws ?? [640, 960])[1]}.webp`)}
                    srcset={(c.ws ?? [640, 960]).map((w) => `${u(`/media/servicios/${c.img}-${w}.webp`)} ${w}w`).join(', ')}
                    sizes="(min-width: 900px) 30vw, 92vw"
                    width="960"
                    height={c.ws ? '960' : '720'}
                    alt={c.alt}
                    loading="lazy"
                    decoding="async"
                    style={`object-position:${c.pos}`}
                  />
                </noscript>
                <span class="svc__sweep" aria-hidden="true"></span>
              </div>
              <span class="svc__edge" aria-hidden="true"></span>
              {c.tag && <span class="svc__tag">{c.tag}</span>}
            </div>
            <div class="svc__body">
              <p class="svc__num">{c.n}</p>
              <h3 class="svc__name">{c.title} <span class="accent">{c.accent}</span></h3>
              <p class="svc__lead">{c.lead}</p>
              <ul class="svc__list">
                {c.items.map((i) => <li>{i}</li>)}
              </ul>
              <a class="svc__link" href="#contacto" data-need={c.need} data-topic={c.topic} data-cta="servicio-tarjeta">
                Conversemos
                <span class="btn__arrow" aria-hidden="true" set:html={arrow} />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="wall" aria-labelledby="titulo-muro">
      <h3 class="section__label" id="titulo-muro">Todo lo que hacemos</h3>
      {wall.map((g, gi) => (
        <div class="wall__group">
          <p class="wall__group-name">{String.fromCharCode(65 + gi)} — {g.group}</p>
          <ul class="wall__list">
            {g.items.map((item, i) => (
              <li class="wall__row" data-row>
                <a href="#contacto" data-need={item.need} data-topic={item.t} data-cta="servicio-muro">
                  <span class="wall__idx">{String.fromCharCode(65 + gi)}.{String(i + 1).padStart(2, '0')}</span>
                  <span class="wall__text">{item.t}</span>
                  <span class="wall__go" aria-hidden="true" set:html={arrow} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  // Ficha 603: asigna la imagen real de cada tarjeta cuando está a 1 000 px de entrar en pantalla, al pulsar un ancla (#…) o si la página abre con ancla.
  // Sin IntersectionObserver, de una vez. `__svcLazy` avisa a motion.ts que este script corrió (si no, motion.ts hace de respaldo).
  (function () {
    try {
      window.__svcLazy = true;
      var done = function (i) { i.classList.remove('is-lazy-loading'); };
      var go = function (i) {
        var src = i.getAttribute('data-lazy-src');
        if (!src) return;
        var set = i.getAttribute('data-lazy-srcset');
        i.removeAttribute('data-lazy-src');
        i.removeAttribute('data-lazy-srcset');
        i.classList.add('is-lazy-loading');
        i.addEventListener('load', function () { done(i); }, { once: true });
        i.addEventListener('error', function () { done(i); }, { once: true });
        if (set) i.srcset = set;
        i.src = src;
      };
      var all = function () { [].forEach.call(document.querySelectorAll('img[data-lazy-src]'), go); };
      if (!('IntersectionObserver' in window)) { all(); return; }
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          [].forEach.call(e.target.querySelectorAll('img[data-lazy-src]'), go);
        });
      }, { rootMargin: '1000px 0px' });
      [].forEach.call(document.querySelectorAll('[data-svc]'), function (c) { io.observe(c); });
      if (location.hash.length > 1) all();
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[href^="#"]');
        if (a && a.getAttribute('href').length > 1) all();
      }, true);
    } catch (err) { document.querySelectorAll && [].forEach.call(document.querySelectorAll('img[data-lazy-src]'), function (i) { i.src = i.getAttribute('data-lazy-src'); var t = i.getAttribute('data-lazy-srcset'); if (t) i.srcset = t; }); }
  })();
</script>
