---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import Nav from '../components/Nav.astro';
import Services from '../components/Services.astro';
import Projects from '../components/Projects.astro';
import AiInAction from '../components/AiInAction.astro';
import Method from '../components/Method.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import Diagnostic from '../components/Diagnostic.astro';
import { EMAIL, whatsapp, WA_HELLO, WA_ICON } from '../config/contact';

const wa = whatsapp(); // null mientras no haya número confirmado
const mail = '#contacto'; // el diagnóstico se pide en el formulario del cierre
const arrow = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>`;
---

<Base
  title="Bombvstic · Marketing digital & AI Solutions en Santiago de Chile"
  description="Marca, contenido, campañas y tecnología a medida en un solo equipo. Agencia de marketing digital y soluciones de IA en Santiago de Chile."
>
  <Nav />

  <ol class="chapters" aria-label="Capítulos" data-chapters>
    <li><a href="#inicio" data-chapter="inicio"><span class="num">00</span><span class="name">Inicio</span></a></li>
    <li><a href="#manifiesto" data-chapter="manifiesto"><span class="num">01</span><span class="name">Manifiesto</span></a></li>
    <li><a href="#servicios" data-chapter="servicios"><span class="num">02</span><span class="name">Servicios</span></a></li>
    <li><a href="#proyectos" data-chapter="proyectos"><span class="num">03</span><span class="name">Proyectos</span></a></li>
    <li><a href="#ia" data-chapter="ia"><span class="num">04</span><span class="name">IA en acción</span></a></li>
    <li><a href="#metodo" data-chapter="metodo"><span class="num">05</span><span class="name">Método</span></a></li>
    <li><a href="#equipo" data-chapter="equipo"><span class="num">06</span><span class="name">Equipo</span></a></li>
    <li><a href="#preguntas" data-chapter="preguntas"><span class="num">07</span><span class="name">Preguntas</span></a></li>
    <li><a href="#contacto" data-chapter="contacto"><span class="num">08</span><span class="name">Contacto</span></a></li>
  </ol>

  <main id="contenido" tabindex="-1">
    <section class="hero" id="inicio" data-atmo-on="violet" data-section="inicio" aria-labelledby="titulo-hero">
      <div class="hero__grid">
        <div class="hero__copy">
          <p class="kicker" data-reveal>Marketing digital &amp; AI Solutions</p>
          <!-- Titular aprobado: opción B, ahora apilado y escalonado (hero tipográfico).
               El "chip" es decorativo: muestra el motion real del caso Digital Sneakers Shop. -->
          <h1 class="hero__title" id="titulo-hero" data-hero-title>
            <span class="line line--1"><span>Marca,
              <span class="hchip" aria-hidden="true" data-chip>
                <span class="hchip__media">
                  <img src={u('/media/proyectos/dss-03-480.webp')} alt="" width="480" height="600" decoding="async" fetchpriority="low" />
                  <video
                    data-chip-video
                    data-src={u('/media/proyectos/dss-03-motion.mp4')}
                    muted
                    loop
                    playsinline
                    preload="none"
                    tabindex="-1"
                  ></video>
                </span>
              </span>
            </span></span>
            <span class="line line--2"><span>contenido</span></span>
            <span class="line line--3"><span>y tecnología.</span></span>
            <span class="line line--4"><span>Un solo <span class="accent">equipo.</span></span></span>
          </h1>
          <div class="hero__sub">
            <p class="hero__lead" data-reveal>
              Estrategia, campañas, contenido y software a medida para negocios que quieren crecer en serio. Desde Santiago de Chile.
            </p>
            <div class="hero__actions" data-reveal>
              <a class="btn btn--primary" href={mail} data-magnetic data-hero-cta data-cta="hero">
                Agendar diagnóstico
                <span class="btn__arrow" aria-hidden="true" set:html={arrow} />
              </a>
              <a class="btn btn--ghost" href="https://www.instagram.com/bombvstic/" target="_blank" rel="noopener" data-cta="hero-instagram">Ver Instagram</a>
            </div>
          </div>
        </div>

        <div class="hero__stage" data-stage>
          <div class="stage__light" aria-hidden="true"></div>
          <div class="stage__cut" aria-hidden="true" data-stage-cut></div>
          <div class="emblem" data-emblem>
            <div class="emblem__tilt" data-tilt>
            <img
              src={u('/brand/emblema-720.webp')}
              srcset={`${u('/brand/emblema-480.webp')} 480w, ${u('/brand/emblema-720.webp')} 720w, ${u('/brand/emblema-960.webp')} 960w`}
              sizes="(min-width: 900px) 34rem, (min-width: 520px) min(72vw, 26rem), min(58vw, 15rem)"
              alt="Emblema de Bombvstic: una B de titanio atravesada por un rayo violeta"
              width="720"
              height="720"
              fetchpriority="high"
              decoding="async"
            />
            <div class="emblem__sweep" aria-hidden="true"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="marquee" aria-hidden="true" data-marquee data-reveal>
        <div class="marquee__track" data-marquee-track>
          {[0, 1].map(() => (
            <div class="marquee__group">
              <span class="marquee__word">Estrategia</span><i>/</i>
              <span class="marquee__word marquee__word--solid">Diseño</span><i>/</i>
              <span class="marquee__word">Tecnología</span><i>/</i>
            </div>
          ))}
        </div>
      </div>

      <div class="hero__foot" data-reveal>
        <a class="hero__proof" href="#proyectos">
          <span class="hero__proof-label">Trabajos recientes</span>
          <b>Digital Sneakers Shop</b>
          <i aria-hidden="true">·</i>
          <b>Calyzzo</b>
          <span class="hero__proof-arrow" aria-hidden="true" set:html={arrow} />
        </a>
        <a class="hero__scroll" href="#manifiesto">
          <span class="hero__scroll-line" aria-hidden="true"></span>
          Desliza
        </a>
      </div>
    </section>

    <section class="section section--cut section--surface" id="manifiesto" data-atmo-on="silver" data-section="manifiesto" aria-labelledby="titulo-manifiesto">
      <div class="section__inner">
        <p class="section__label"><b>01</b> — Manifiesto</p>
        <h2 class="manifesto" id="titulo-manifiesto" data-manifesto data-scrub-words>
          Cada decisión tiene un propósito. Cada marca merece una <span class="accent">estrategia.</span>
        </h2>
        <p class="manifesto__sub" data-reveal>
          Somos Bombvstic: marketing, contenido y tecnología en un mismo equipo, desde Santiago de Chile. Diseñamos lo que tu negocio necesita para ser elegido y lo construimos hasta que funcione.
        </p>
      </div>
    </section>

    <Services />
    <Projects />
    <AiInAction />
    <Method />
    <Team />
    <Faq />

    <Diagnostic />
  </main>

  <footer class="footer">
    <div class="footer__inner">
      <img class="footer__wordmark" data-wordmark src={u('/brand/wordmark-web-600.webp')} alt="Bombvstic" width="600" height="240" loading="lazy" decoding="async" />
      <div class="footer__cols">
        <div>
          <h2>Escríbenos</h2>
          <ul><li><a href={`mailto:${EMAIL}`} data-cta="pie-correo">{EMAIL}</a></li>
            {wa && <li><a href={wa.href(WA_HELLO)} target="_blank" rel="noopener" data-cta="whatsapp-pie">WhatsApp<span class="sr-only"> (se abre en otra pestaña)</span></a></li>}</ul>
        </div>
        <div>
          <h2>Síguenos</h2>
          <ul><li><a href="https://www.instagram.com/bombvstic/" target="_blank" rel="noopener" data-cta="pie-instagram">Instagram</a></li></ul>
        </div>
        <div>
          <h2>Estamos en</h2>
          <ul><li>Santiago de Chile · <span class="footer__clock" data-clock>--:--</span></li></ul>
        </div>
      </div>
      <div class="footer__legal">
        <span>© 2026 Bombvstic · Marketing digital &amp; AI Solutions</span>
        <a class="footer__link" href={u('/privacidad/')}>Privacidad</a>
        <a class="footer__link footer__top" href="#inicio">Volver arriba <span aria-hidden="true">↑</span></a>
      </div>
    </div>
  </footer>

  <!-- Pastilla de acceso rápido (solo celular): aparece cuando el botón del hero ya salió por arriba y se va en el cierre y el pie. -->
  <aside class="dock" aria-label="Acceso rápido" data-dock>
    <a class="btn btn--primary btn--sm" href={mail} data-cta="pastilla">
      Agendar diagnóstico
      <span class="btn__arrow" aria-hidden="true" set:html={arrow} />
    </a>
    {wa && (
      <a class="dock__wa" href={wa.href(WA_HELLO)} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp (se abre en otra pestaña)" data-cta="whatsapp-pastilla">
        <span aria-hidden="true" set:html={WA_ICON} />
      </a>
    )}
  </aside>
</Base>
