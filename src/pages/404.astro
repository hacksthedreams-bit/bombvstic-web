---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
const arrow = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>`;
---

<Base title="Página no encontrada · Bombvstic" description="Esta página no existe. Vuelve al inicio de Bombvstic." path="/404">
  <main id="contenido" class="lost">
    <p class="kicker">Error 404</p>
    <h1 class="lost__title">Este corte <span class="accent">no existe.</span></h1>
    <p class="lost__lead">La página que buscas no está aquí. Vuelve al inicio y seguimos desde ahí.</p>
    <a class="btn btn--primary btn--lg" href={u('/')}>
      Volver al inicio
      <span class="btn__arrow" aria-hidden="true" set:html={arrow} />
    </a>
  </main>
</Base>

<style>
  .lost {
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.5rem;
    padding: calc(var(--nav-h) + 2rem) var(--gutter) 4rem;
    max-width: var(--maxw);
    margin-inline: auto;
  }
  .lost__title {
    margin: 0;
    font-weight: 600;
    font-size: clamp(2.8rem, 9vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .lost__lead {
    margin: 0;
    max-width: 30rem;
    color: var(--muted);
    font-size: 1.15rem;
  }
</style>
